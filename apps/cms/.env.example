# A generated secret for Payload: openssl rand -hex 32
PAYLOAD_SECRET=

# A GitHub token that can send repository_dispatch to frippz/justfredrik.com.
# Without it, publishing doesn't deploy the site. In production it's a Worker secret.
GITHUB_DISPATCH_TOKEN=

# Where this CMS and the site run. They default to localhost:3000 and the site's
# dev server on localhost:5173, or the production URLs when NODE_ENV=production.
SERVER_URL=
SITE_URL=
