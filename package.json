{
  "name": "justfredrik.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter web build",
    "test": "pnpm --filter web test",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:format && pnpm -r check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,svelte}\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
